#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
atunnel-verify: aTunnel 一致性校验与自动修复
检查 配置(期望态) vs 运行态(iptables/socat/Windows转发器) 是否一致
用法: atunnel-verify [--fix]   (--fix 自动修复缺失/多余项)
作者: weiyufei
"""
import json
import re
import socket
import subprocess
import sys

WSL_CONF = "/etc/wsl-atrust-forward.conf"
WIN_JSON = "/mnt/c/Users/yfvia/AppData/Local/wsl-atrust-portmapper/portmapper.json"
SOCAT_LOG = "/var/log/wsl-atrust-socat.log"

G = "\033[0;32m"
R = "\033[0;31m"
Y = "\033[1;33m"
N = "\033[0m"

FIX = len(sys.argv) > 1 and sys.argv[1] == "--fix"


def sh(cmd, timeout=10):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except Exception:
        return ""


def get_local_ip():
    return sh("ip -4 addr show 2>/dev/null | awk '/inet 172\\.16\\.203\\./{gsub(/\\/.*/,\"\",$2); print $2; exit}'").strip()


def load_expect():
    expect = []
    with open(WSL_CONF, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            p = line.split()
            if len(p) == 3:
                expect.append((p[0], int(p[1]), int(p[2])))
    return expect


def check_iptables(ip, port, local_ip, lport):
    rule = "iptables -t nat -S OUTPUT | grep '%s/32' | grep -- '--dport %d'" % (ip, port)
    return bool(sh(rule).strip())


def check_socat(lport):
    return bool(sh("ss -tln | grep -c ':%d '" % lport).strip())


def check_win_listener(port):
    try:
        s = socket.create_connection(("127.0.0.1", port), timeout=2)
        s.close()
        return True
    except Exception:
        return False


def main():
    expect = load_expect()
    local_ip = get_local_ip()
    print("=== aTunnel 一致性校验 ===")
    print("期望映射: %d 个, 本机 IP: %s" % (len(expect), local_ip or "无"))
    issues = 0

    # 1-3. 缺失检查
    for ip, port, lport in expect:
        if not check_iptables(ip, port, local_ip, lport):
            print(R + "  [缺失] iptables 规则 %s:%d" % (ip, port) + N)
            issues += 1
            if FIX and local_ip:
                sh("iptables -t nat -A OUTPUT -d %s -p tcp --dport %d -j DNAT --to-destination %s:%d"
                   % (ip, port, local_ip, lport))
                issues -= 1
                print(G + "  [已修复] 补齐 iptables 规则" + N)
        if not check_socat(lport):
            print(R + "  [缺失] socat 监听 %d (转发 %s:%d)" % (lport, ip, port) + N)
            issues += 1
            if FIX and local_ip:
                subprocess.Popen(
                    "nohup socat TCP-LISTEN:%d,bind=%s,reuseaddr,fork TCP:127.0.0.1:%d >> %s 2>&1 &"
                    % (lport, local_ip, port, SOCAT_LOG), shell=True)
                issues -= 1
                print(G + "  [已修复] 拉起 socat :%d" % lport + N)
        if not check_win_listener(port):
            print(R + "  [缺失] Windows 转发器未监听 %d (%s:%d), 检查 portmapper 是否运行" % (port, ip, port) + N)
            issues += 1

    # 4. 多余检查: socat 监听端口不在期望中
    socats = sh("ps aux | grep 'socat TCP-LISTEN' | grep -v grep")
    expect_lports = {x[2] for x in expect}
    for line in socats.splitlines():
        m = re.search(r"TCP-LISTEN:(\d+),", line)
        if m and int(m.group(1)) not in expect_lports:
            print(Y + "  [多余] socat 监听 %s 不在配置中" % m.group(1) + N)
            issues += 1
            if FIX:
                sh("pkill -f 'socat TCP-LISTEN:%s,'" % m.group(1))
                print(G + "  [已修复] 清理多余 socat" + N)

    print("")
    if issues == 0:
        print(G + "✅ 一致性正常: 配置与运行态完全一致" + N)
    else:
        print(Y + "发现 %d 处不一致 (加 --fix 自动修复)" % issues + N)
        sys.exit(1)


if __name__ == "__main__":
    main()
