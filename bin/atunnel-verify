#!/bin/bash
# [v2] 委托到清单式校验（v1 以 /etc/wsl-atrust-forward.conf 为期望态，已退役，源码见 legacy/atunnel-verify）
case "${1:-}" in
  "" )            exec /usr/local/bin/atunnel-env doctor ;;
  -h|--help|help) echo "用法: atunnel-verify [env]   # 不带 env = 校验全部（等价 atunnel doctor）"; exit 0 ;;
  * )             exec /usr/local/bin/atunnel-env verify "$1" ;;
esac
